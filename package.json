{
  "name": "gitlab-compliance",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.17.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --experimental-strip-types --env-file-if-exists=.env src/server.ts",
    "collect": "node --experimental-strip-types --env-file-if-exists=.env src/cli/collect.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "db:setup": "node --experimental-strip-types --env-file-if-exists=.env src/cli/db-setup.ts",
    "history": "node --experimental-strip-types --env-file-if-exists=.env src/cli/history.ts",
    "selection": "node --experimental-strip-types --env-file-if-exists=.env src/cli/selection.ts",
    "dev:ui": "vite",
    "build": "npm run typecheck && vite build",
    "test:ui": "node --experimental-strip-types tests/ui.smoke.ts",
    "demo:mock": "node --experimental-strip-types demo/start.ts",
    "demo:verify": "node --experimental-strip-types demo/verify.ts",
    "verify": "npm test && npm run build && npm run demo:verify"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
